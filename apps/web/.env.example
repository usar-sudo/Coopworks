# Fieldwork Trust — environment variables
# =======================================
# DEMO-FIRST: with the Supabase keys empty the app runs fully in demo mode
# (persona logins + in-memory data). Add real keys to go live automatically.

# --- Supabase (live mode) ------------------------------------------------
# Project URL + anon key: Supabase Dashboard → Project Settings → API.
# Leave empty for demo mode.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Optional integrations ------------------------------------------------
# GOOGLE_MAPS_API_KEY: optional Google Maps reverse-geocoding. Falls back to
# GPS coordinate display when not set. (Map UI itself is Leaflet/OSM — keyless.)
GOOGLE_MAPS_API_KEY=""
